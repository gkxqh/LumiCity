<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ccb.lighting.module.publish.mapper.LedProgramMapper">

    <resultMap id="programWithScreen" type="com.ccb.lighting.module.publish.entity.LedProgram" autoMapping="true">
        <result column="screen_name" property="screenName"/>
    </resultMap>

    <select id="pageListByQuery" resultMap="programWithScreen">
        SELECT
            p.*,
            d.device_name AS screen_name
        FROM led_program p
        LEFT JOIN dev_device d ON p.screen_id = d.id
        <where>
            p.deleted = 0
            <if test="query.programName != null and query.programName != ''">
                AND p.program_name LIKE CONCAT('%', #{query.programName}, '%')
            </if>
            <if test="query.mediaType != null and query.mediaType != ''">
                AND p.media_type = #{query.mediaType}
            </if>
            <if test="query.status != null">
                AND p.status = #{query.status}
            </if>
        </where>
        ORDER BY p.create_time DESC
    </select>

</mapper>